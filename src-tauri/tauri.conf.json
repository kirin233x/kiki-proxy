{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiki-proxy",
  "version": "0.1.0",
  "identifier": "com.kirin233x.kiki-proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "kiki-proxy",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "本地 AI 网关",
    "longDescription": "kiki-proxy 是一个本地 AI 网关：统一接入 Claude Code、Codex、Gemini CLI 等客户端，按模型路由到不同端点，支持协议转换、分流代理、故障切换与插件。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
